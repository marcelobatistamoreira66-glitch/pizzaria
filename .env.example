# N8n Configuration
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-this-password

# Database
DB_TYPE=sqlite
DB_SQLITE_DATABASE=database/pizzaria.db

# WhatsApp/Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=pizzaria

# OpenAI / IA
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7

# Pizzaria Configuration
PIZZARIA_NOME=Pizzaria Bella
PIZZARIA_TELEFONE=+5511999999999
PIZZARIA_ENDERECO=Rua das Pizzas, 123 - São Paulo, SP
PIZZARIA_HORARIO_ABERTURA=18:00
PIZZARIA_HORARIO_FECHAMENTO=23:00

# Delivery
DELIVERY_TAXA_FIXA=5.00
DELIVERY_TEMPO_MEDIO=40
DELIVERY_RAIO_KM=10

# Payment
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token
PIX_KEY=your-pix-key

# Notifications
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=true

# Redis (optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Timezone
TZ=America/Sao_Paulo
