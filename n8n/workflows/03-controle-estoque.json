{
  "name": "📊 Controle de Estoque",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "id": "trigger-verificacao",
      "name": "Trigger - A cada 4 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  p.id,\n  p.nome,\n  p.estoque_atual,\n  p.estoque_minimo,\n  c.nome as categoria\nFROM produtos p\nJOIN categorias c ON c.id = p.categoria_id\nWHERE p.estoque_atual <= p.estoque_minimo\n  AND p.disponivel = true\nORDER BY (p.estoque_minimo - p.estoque_atual) DESC",
        "options": {}
      },
      "id": "verificar-estoque-baixo",
      "name": "Verificar Estoque Baixo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Pizzaria"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.length}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "tem-produtos-baixos",
      "name": "Tem Produtos com Estoque Baixo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const produtos = $input.all();\n\nlet mensagem = '⚠️ *ALERTA DE ESTOQUE BAIXO*\\n\\n';\nmensagem += `${produtos.length} produto(s) com estoque baixo:\\n\\n`;\n\nprodutos.forEach((item, idx) => {\n  const produto = item.json;\n  mensagem += `${idx + 1}. *${produto.nome}*\\n`;\n  mensagem += `   Categoria: ${produto.categoria}\\n`;\n  mensagem += `   Atual: ${produto.estoque_atual} | Mínimo: ${produto.estoque_minimo}\\n`;\n  mensagem += `   ⚠️ Faltam: ${produto.estoque_minimo - produto.estoque_atual} unidades\\n\\n`;\n});\n\nmensagem += '🔔 Providencie a reposição!';\n\nreturn {\n  json: {\n    mensagem: mensagem,\n    produtos_baixos: produtos.map(p => p.json)\n  }\n};"
      },
      "id": "formatar-alerta",
      "name": "Formatar Alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "={{$env.EVOLUTION_API_URL}}/message/sendText/{{$env.EVOLUTION_INSTANCE_NAME}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{$env.PIZZARIA_TELEFONE}}"
            },
            {
              "name": "text",
              "value": "={{$json.mensagem}}"
            }
          ]
        },
        "options": {}
      },
      "id": "enviar-alerta-gestor",
      "name": "Enviar Alerta para Gestor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3",
          "name": "Evolution API Header"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "atualizar-estoque",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-atualizar-estoque",
      "name": "Webhook Atualizar Estoque",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 600],
      "webhookId": "webhook-atualizar-estoque"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT estoque_atual FROM produtos WHERE id = {{$json.produto_id}}",
        "options": {}
      },
      "id": "buscar-estoque-atual",
      "name": "Buscar Estoque Atual",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [460, 600],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Pizzaria"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dadosAtualizacao = $('Webhook Atualizar Estoque').first().json;\nconst estoqueAtual = $json.estoque_atual;\n\nlet novoEstoque;\nconst tipo = dadosAtualizacao.tipo; // entrada, saida, ajuste\nconst quantidade = parseInt(dadosAtualizacao.quantidade);\n\nswitch(tipo) {\n  case 'entrada':\n    novoEstoque = estoqueAtual + quantidade;\n    break;\n  case 'saida':\n    novoEstoque = estoqueAtual - quantidade;\n    break;\n  case 'ajuste':\n    novoEstoque = quantidade; // ajuste define o valor absoluto\n    break;\n  default:\n    throw new Error('Tipo de movimentação inválido');\n}\n\nif (novoEstoque < 0) {\n  throw new Error('Estoque não pode ser negativo');\n}\n\nreturn {\n  json: {\n    produto_id: dadosAtualizacao.produto_id,\n    tipo: tipo,\n    quantidade: quantidade,\n    quantidade_anterior: estoqueAtual,\n    quantidade_atual: novoEstoque,\n    motivo: dadosAtualizacao.motivo || '',\n    observacoes: dadosAtualizacao.observacoes || '',\n    usuario: dadosAtualizacao.usuario || 'sistema'\n  }\n};"
      },
      "id": "calcular-novo-estoque",
      "name": "Calcular Novo Estoque",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 600]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE produtos \nSET estoque_atual = {{$json.quantidade_atual}},\n    updated_at = CURRENT_TIMESTAMP\nWHERE id = {{$json.produto_id}}",
        "options": {}
      },
      "id": "atualizar-estoque-produto",
      "name": "Atualizar Estoque Produto",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [900, 600],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Pizzaria"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "estoque_movimentacoes",
        "columns": "produto_id, tipo, quantidade, quantidade_anterior, quantidade_atual, motivo, observacoes, usuario",
        "values": "={{$('Calcular Novo Estoque').first().json.produto_id}}, {{$('Calcular Novo Estoque').first().json.tipo}}, {{$('Calcular Novo Estoque').first().json.quantidade}}, {{$('Calcular Novo Estoque').first().json.quantidade_anterior}}, {{$('Calcular Novo Estoque').first().json.quantidade_atual}}, {{$('Calcular Novo Estoque').first().json.motivo}}, {{$('Calcular Novo Estoque').first().json.observacoes}}, {{$('Calcular Novo Estoque').first().json.usuario}}",
        "options": {}
      },
      "id": "registrar-movimentacao",
      "name": "Registrar Movimentação",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1120, 600],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Pizzaria"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"estoque_anterior\": $('Calcular Novo Estoque').first().json.quantidade_anterior, \"estoque_atual\": $('Calcular Novo Estoque').first().json.quantidade_atual } }}",
        "options": {}
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 600]
