    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pi.produto_id, pi.quantidade, p.nome\nFROM pedido_itens pi\nJOIN produtos p ON p.id = pi.produto_id\nWHERE pi.pedido_id = {{$json.pedido_id}}",
        "options": {}
      },
      "id": "buscar-itens-pedido",
      "name": "Buscar Itens do Pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [460, 900],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Pizzaria"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE produtos \nSET estoque_atual = estoque_atual - {{$json.quantidade}},\n    updated_at = CURRENT_TIMESTAMP\nWHERE id = {{$json.produto_id}}\nRETURNING id, nome, estoque_atual",
        "options": {}
      },
      "id": "dar-baixa-estoque",
      "name": "Dar Baixa no Estoque",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [680, 900],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "PostgreSQL - Pizzaria"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "estoque_movimentacoes",
        "columns": "produto_id, tipo, quantidade, motivo, usuario",
        "values": "={{$json.id}}, saida, {{$('Buscar Itens do Pedido').item.json.quantidade}}, Venda - Pedido #{{$('Webhook Baixa por Pedido').first().json.pedido_id}}, sistema",
        "options": {}
      },
      "id": "registrar-movimentacao-pedido",
