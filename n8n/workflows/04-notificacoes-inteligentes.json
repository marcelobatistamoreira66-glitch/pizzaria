      "id": "trigger-lembrete-avaliacoes",
      "name": "Trigger - 20h diariamente",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 1000]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  p.id,\n  p.numero_pedido,\n  c.telefone,\n  c.nome as cliente_nome,\n  p.total,\n  p.entregue_em\nFROM pedidos p\nJOIN clientes c ON c.id = p.cliente_id\nWHERE p.status = 'entregue'\n  AND DATE(p.entregue_em) = CURRENT_DATE\n  AND p.avaliacao IS NULL\nORDER BY p.entregue_em DESC",
        "options": {}
      },
